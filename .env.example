# Переменные задаются в панели Amvera (раздел «Переменные», ключи — как секреты).
# На этапе сборки Amvera переменные не передаёт: здесь только то, что читается во время работы сервера.

# Куда отправлять заявки: yougile (до запуска CRM) или bitrix (с 31.01.2027)
LEAD_TARGET=yougile

# YouGile: ключ API, колонка «Новая заявка» на доске заявок
YOUGILE_API_KEY=
YOUGILE_COLUMN_ID=
# Необязательно: адрес API, если отличается от https://ru.yougile.com/api-v2
YOUGILE_BASE_URL=
# Необязательно: стикер «Источник» и id его состояний по источникам
YOUGILE_STICKER_SOURCE_ID=
# Пример: {"direct":"id-состояния","site":"id-состояния","avito":"id-состояния"}
YOUGILE_SOURCE_STATES=

# Битрикс24: входящий вебхук с правами CRM, воронка «Заказ дома»
BITRIX_WEBHOOK_URL=
BITRIX_DEAL_CATEGORY_ID=
